---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header/Header.astro';
import Hero from '../components/Hero/Hero.astro';
import About from '../components/About/About.astro';
import Experience from '../components/Experience/Experience.astro';
import Projects from '../components/Projects/Projects.astro';
import Skills from '../components/Skills/Skills.astro';
import EngineeringInterests from '../components/Engineering/EngineeringInterests.astro';
import Contact from '../components/Contact/Contact.astro';
import Footer from '../components/Footer/Footer.astro';
import AskAlpesh from '../components/Assistant/AskAlpesh.astro';
---

<MainLayout
  title="Alpesh Prajapati | Software Engineer — Backend-Focused Full Stack Developer"
  description="Backend-focused full stack software engineer with nearly 3 years of experience. Specializes in Node.js, TypeScript, NestJS, Express.js, React.js, microservices, and scalable API architecture. Based in Ahmedabad, India."
>
  <!-- Header & Sidebars -->
  <Header />

  <!-- Main content -->
  <main id="main" class="mx-auto" style="max-width: 1400px;">
    <Hero />
    <About />
    <Experience />
    <Projects />
    <Skills />
    <EngineeringInterests />
    <Contact />
  </main>

  <Footer />

  <!-- AI Portfolio Assistant -->
  <AskAlpesh />
</MainLayout>
