---
// src/components/Hero/Hero.astro
import { profile } from '../../data/profile';
---

<section
  class="min-h-screen flex items-center justify-center py-24 md:py-0"
  aria-label="Introduction"
>
  <div class="section-container w-full">
    <div class="max-w-4xl">
      <!-- Greeting -->
      <p
        class="font-mono text-sm md:text-base mb-5"
        style="color: var(--color-accent-primary); opacity:0; transform: translateY(20px); transition: opacity 0.6s ease 0.8s, transform 0.6s ease 0.8s;"
        data-page-anim
        data-delay="800"
      >
        Hi, my name is
      </p>

      <!-- Name -->
      <h1
        class="text-5xl md:text-7xl font-bold leading-tight mb-3"
        style="color: var(--color-text-primary); font-size: clamp(2.5rem, 8vw, 4.5rem); opacity:0; transform: translateY(20px); transition: opacity 0.6s ease 0.9s, transform 0.6s ease 0.9s;"
        data-page-anim
        data-delay="900"
      >
        {profile.name}.
      </h1>

      <!-- Tagline -->
      <h2
        class="text-3xl md:text-5xl font-bold mb-8 leading-snug"
        style="color: var(--color-text-secondary); font-size: clamp(1.6rem, 5vw, 3rem); opacity:0; transform: translateY(20px); transition: opacity 0.6s ease 1s, transform 0.6s ease 1s;"
        data-page-anim
        data-delay="1000"
      >
        {profile.tagline}
      </h2>

      <!-- Description -->
      <p
        class="max-w-2xl text-base md:text-lg leading-relaxed mb-10"
        style="color: var(--color-text-secondary); opacity:0; transform: translateY(20px); transition: opacity 0.6s ease 1.1s, transform 0.6s ease 1.1s;"
        data-page-anim
        data-delay="1100"
      >
        {profile.description}
      </p>

      <!-- CTA Buttons -->
      <div
        class="flex flex-wrap gap-4"
        style="opacity:0; transform: translateY(20px); transition: opacity 0.6s ease 1.2s, transform 0.6s ease 1.2s;"
        data-page-anim
        data-delay="1200"
      >
        <a href="#projects" class="btn-outline" id="hero-view-work">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
          View My Work
        </a>
        <a
          href={profile.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline"
          id="hero-resume"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download Resume
        </a>
        <a
          href="https://github.com/AlpeshMPrajapati"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
          id="hero-github"
          aria-label="GitHub Profile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
        </a>
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
          id="hero-linkedin"
          aria-label="LinkedIn Profile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
      </div>

      <!-- Scroll indicator -->
      <div
        class="mt-16 flex flex-col items-start gap-2"
        style="opacity:0; transition: opacity 0.6s ease 1.5s;"
        data-page-anim
        data-delay="1500"
        aria-hidden="true"
      >
        <span class="font-mono text-xs" style="color: var(--color-text-muted);">scroll</span>
        <div class="scroll-indicator w-px h-12 relative overflow-hidden" style="background: var(--color-border-subtle);">
          <div class="scroll-line absolute top-0 left-0 w-full h-1/2" style="background: var(--color-accent-primary); animation: scrollDown 1.8s ease-in-out infinite;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes scrollDown {
    0% { transform: translateY(-100%); opacity: 1; }
    80% { transform: translateY(200%); opacity: 1; }
    100% { transform: translateY(200%); opacity: 0; }
  }
</style>
