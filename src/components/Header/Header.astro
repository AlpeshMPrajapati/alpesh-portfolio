---
// src/components/Header/Header.astro
import { profile } from '../../data/profile';
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  style="background: rgba(13,13,20,0); border-bottom: 1px solid transparent;"
>
  <div class="section-container h-16 flex items-center justify-between">
    <!-- Logo -->
    <a
      href="/"
      class="font-mono text-xl font-bold transition-colors duration-200"
      style="color: var(--color-accent-primary); opacity:0; transform: translateY(-16px); transition: opacity 0.4s ease 0.1s, transform 0.4s ease 0.1s;"
      aria-label="Home"
      data-page-anim
      data-delay="100"
    >
      <span>&lt;</span>AP<span>/&gt;</span>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Primary navigation" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm font-medium">
        {(['About', 'Experience', 'Projects', 'Skills', 'Contact'] as const).map((item, i) => (
          <li>
            <a
              href={`#${item.toLowerCase()}`}
              class="nav-link text-sm"
              data-page-anim
              data-delay={(200 + i * 100).toString()}
              style="opacity:0; transform: translateY(-16px); transition: opacity 0.4s ease, transform 0.4s ease;"
            >
              {item}
            </a>
          </li>
        ))}
        <li>
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline text-sm py-2 px-4"
            data-page-anim
            data-delay="700"
            style="opacity:0; transform: translateY(-16px); transition: opacity 0.4s ease, transform 0.4s ease;"
          >
            Resume
          </a>
        </li>
        <!-- Desktop Theme Toggle -->
        <li>
          <button
            type="button"
            class="theme-toggle-btn"
            aria-label="Toggle dark/light theme"
            title="Toggle theme"
            data-page-anim
            data-delay="800"
            style="opacity:0; transform: translateY(-16px); transition: opacity 0.4s ease, transform 0.4s ease;"
          >
            <!-- Sun icon (shown in dark mode to switch to light) -->
            <svg class="sun-icon w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon icon (shown in light mode to switch to dark) -->
            <svg class="moon-icon w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </li>
      </ul>
    </nav>

    <!-- Mobile Header Right Actions -->
    <div class="flex items-center gap-3 md:hidden">
      <!-- Mobile Theme Toggle -->
      <button
        type="button"
        class="theme-toggle-btn"
        aria-label="Toggle dark/light theme"
        title="Toggle theme"
      >
        <svg class="sun-icon w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="moon-icon w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="relative z-50 w-10 h-10 flex flex-col items-center justify-center gap-[6px]"
      >
        <span id="mb1" class="block w-6 h-[2px] transition-all duration-300" style="background: var(--color-accent-primary);"></span>
        <span id="mb2" class="block w-6 h-[2px] transition-all duration-300" style="background: var(--color-accent-primary);"></span>
        <span id="mb3" class="block w-6 h-[2px] transition-all duration-300" style="background: var(--color-accent-primary);"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Overlay -->
<div id="mobile-nav-overlay" class="mobile-nav-overlay md:hidden" aria-hidden="true"></div>
<nav
  id="mobile-nav-panel"
  class="mobile-nav-panel md:hidden"
  aria-label="Mobile navigation"
>
  <ul class="flex flex-col gap-6">
    {(['About', 'Experience', 'Projects', 'Skills', 'Contact'] as const).map((item, i) => (
      <li>
        <a
          href={`#${item.toLowerCase()}`}
          class="mobile-nav-link flex items-center gap-3 text-lg font-medium transition-colors duration-200"
          style="color: var(--color-text-primary);"
        >
          <span class="font-mono text-sm" style="color: var(--color-accent-primary);">0{i + 1}.</span>
          {item}
        </a>
      </li>
    ))}
    <li class="pt-2">
      <a
        href={profile.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline w-full justify-center"
      >
        Download Resume
      </a>
    </li>
  </ul>
</nav>

<!-- Left sidebar: social icons (desktop only) -->
<aside
  id="sidebar-left"
  class="hidden md:flex fixed left-6 bottom-0 flex-col items-center gap-5 z-30"
  aria-label="Social media links"
  style="opacity: 0; transform: translateX(-30px); transition: opacity 0.6s ease, transform 0.6s ease;"
>
  <a
    href="https://github.com/AlpeshMPrajapati"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GitHub Profile"
    class="btn-ghost"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
    </svg>
  </a>
  <a
    href={profile.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="LinkedIn Profile"
    class="btn-ghost"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
      <rect x="2" y="9" width="4" height="12"/>
      <circle cx="4" cy="4" r="2"/>
    </svg>
  </a>
  <div class="sidebar-dots" aria-hidden="true">
    {Array.from({length: 6}).map((_, i) => (
      <div class="sidebar-dot" style={`opacity: ${(6 - i) / 7};`}></div>
    ))}
  </div>
</aside>

<!-- Right sidebar: email (desktop only) -->
<aside
  id="sidebar-right"
  class="hidden md:flex fixed right-6 bottom-0 flex-col items-center gap-5 z-30"
  aria-label="Email contact"
  style="opacity: 0; transform: translateX(30px); transition: opacity 0.6s ease, transform 0.6s ease;"
>
  <a
    href={`mailto:${profile.email}`}
    class="font-mono text-xs tracking-widest transition-colors duration-200 hover:-translate-y-1"
    style="writing-mode: vertical-rl; color: var(--color-text-secondary);"
    aria-label="Send email to Alpesh"
    onmouseover="this.style.color='var(--color-accent-primary)'"
    onmouseout="this.style.color='var(--color-text-secondary)'"
  >
    {profile.email}
  </a>
  <div class="sidebar-dots" aria-hidden="true">
    {Array.from({length: 6}).map((_, i) => (
      <div class="sidebar-dot" style={`opacity: ${(6 - i) / 7};`}></div>
    ))}
  </div>
</aside>

<script>
  // Header scroll effect
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Theme toggle functionality with smooth transition
  const themeToggleBtns = document.querySelectorAll('.theme-toggle-btn');
  themeToggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      document.documentElement.classList.add('theme-transitioning');
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      if (newTheme === 'light') {
        document.documentElement.classList.add('light');
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      }
      try {
        localStorage.setItem('theme', newTheme);
      } catch (e) {}

      setTimeout(() => {
        document.documentElement.classList.remove('theme-transitioning');
      }, 350);
    });
  });

  // Mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const overlay = document.getElementById('mobile-nav-overlay');
  const panel = document.getElementById('mobile-nav-panel');
  const mb1 = document.getElementById('mb1');
  const mb2 = document.getElementById('mb2');
  const mb3 = document.getElementById('mb3');

  let menuOpen = false;

  function toggleMenu() {
    menuOpen = !menuOpen;
    btn?.setAttribute('aria-expanded', menuOpen.toString());
    overlay?.classList.toggle('open', menuOpen);
    panel?.classList.toggle('open', menuOpen);
    overlay?.setAttribute('aria-hidden', (!menuOpen).toString());
    document.body.style.overflow = menuOpen ? 'hidden' : '';

    if (menuOpen) {
      if (mb1) { mb1.style.transform = 'rotate(45deg) translateY(8px)'; }
      if (mb2) { mb2.style.opacity = '0'; }
      if (mb3) { mb3.style.transform = 'rotate(-45deg) translateY(-8px)'; }
    } else {
      if (mb1) { mb1.style.transform = ''; }
      if (mb2) { mb2.style.opacity = '1'; }
      if (mb3) { mb3.style.transform = ''; }
    }
  }

  btn?.addEventListener('click', toggleMenu);
  overlay?.addEventListener('click', toggleMenu);

  // Close menu on nav link click
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      if (menuOpen) toggleMenu();
    });
  });

  // Sidebar reveal on load
  setTimeout(() => {
    const sidebarL = document.getElementById('sidebar-left');
    const sidebarR = document.getElementById('sidebar-right');
    if (sidebarL) {
      sidebarL.style.opacity = '1';
      sidebarL.style.transform = 'translateX(0)';
    }
    if (sidebarR) {
      sidebarR.style.opacity = '1';
      sidebarR.style.transform = 'translateX(0)';
    }
  }, 1400);

  // Page load animations
  document.querySelectorAll('[data-page-anim]').forEach((el) => {
    const delay = parseInt(el.getAttribute('data-delay') || '0');
    setTimeout(() => {
      (el as HTMLElement).style.opacity = '1';
      (el as HTMLElement).style.transform = 'translateY(0)';
    }, delay);
  });
</script>
