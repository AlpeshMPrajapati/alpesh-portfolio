---
// src/components/Contact/Contact.astro
import { profile } from '../../data/profile';
---

<section id="contact" class="py-24 md:py-32 scroll-mt-16">
  <div class="section-container">
    <div class="max-w-2xl mx-auto text-center">
      <!-- Label -->
      <p class="font-mono text-sm mb-4 reveal" style="color: var(--color-accent-primary); transition-delay: 0s;">
        04. What's next?
      </p>

      <!-- Heading -->
      <h2 class="text-3xl md:text-4xl font-bold mb-6 reveal" style="color: var(--color-text-primary); transition-delay: 0.1s;">
        Get In Touch
      </h2>

      <!-- Description -->
      <p class="text-base leading-relaxed mb-10 reveal" style="color: var(--color-text-secondary); transition-delay: 0.2s;">
        I'm open to discussing new opportunities, interesting engineering challenges, or just connecting professionally.
        Whether you're a recruiter, an engineer, or someone building something worth solving — feel free to reach out.
        I'll do my best to respond.
      </p>

      <!-- Primary CTA -->
      <div class="reveal" style="transition-delay: 0.3s;">
        <a
          href={`mailto:${profile.email}`}
          class="btn-outline text-base px-8 py-4 inline-flex items-center gap-2"
          id="contact-email-btn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
          </svg>
          Say Hello
        </a>
      </div>

      <!-- Secondary links -->
      <div class="flex items-center justify-center gap-6 mt-10 reveal" style="transition-delay: 0.4s;">
        <a
          href="https://github.com/AlpeshMPrajapati"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost text-sm flex items-center gap-2"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
          GitHub
        </a>

        <div style="width: 1px; height: 20px; background: var(--color-border-subtle);"></div>

        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost text-sm flex items-center gap-2"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          LinkedIn
        </a>

        <div style="width: 1px; height: 20px; background: var(--color-border-subtle);"></div>

        <a
          href={profile.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost text-sm flex items-center gap-2"
          aria-label="Download Resume"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Resume
        </a>
      </div>
    </div>
  </div>
</section>
