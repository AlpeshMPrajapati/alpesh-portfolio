---
// src/components/Footer/Footer.astro
---

<footer class="py-8 border-t" style="border-color: var(--color-border-subtle);">
  <div class="section-container">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="font-mono text-xs" style="color: var(--color-text-muted);">
        Designed & built by <span style="color: var(--color-accent-primary);">Alpesh Prajapati</span>
      </p>
      <p class="font-mono text-xs" style="color: var(--color-text-muted);">
        Inspired by <a href="https://pawelbuilds.com" target="_blank" rel="noopener noreferrer" class="keyword-link">Pawel Sloboda</a>
      </p>
      <p class="font-mono text-xs" style="color: var(--color-text-muted);">
        Built with Astro · TypeScript · Tailwind CSS
      </p>
    </div>
  </div>
</footer>
